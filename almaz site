<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ХПВТП «Алмаз» — будівельна компанія, Хмельницький</title>
  <meta name="description" content="ХПВТП «Алмаз» — будівельна компанія у Хмельницькому. Будівництво багатоквартирних і приватних будинків, девелопмент, інженерні мережі, оренда складів." />
  <meta name="theme-color" content="#0A1E3A" />
  <style>
    :root{
      --bg:#071426;
      --bg2:#0A1E3A;
      --card:#0b203f;
      --text:#eaf0ff;
      --muted:rgba(234,240,255,.72);
      --line:rgba(234,240,255,.12);
      --accent:#9fb8ff;
      --shadow: 0 16px 40px rgba(0,0,0,.35);
      --radius:18px;
      --radius2:24px;
      --container: 1120px;
    }

    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    body{
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: radial-gradient(1200px 600px at 20% -10%, rgba(159,184,255,.18), transparent 60%),
                  radial-gradient(900px 500px at 80% 0%, rgba(159,184,255,.10), transparent 55%),
                  linear-gradient(180deg, var(--bg), #04101f 60%, #030b15);
      color: var(--text);
      line-height: 1.55;
    }
    a{color:inherit;text-decoration:none}
    .container{max-width:var(--container);margin:0 auto;padding:0 18px}

    .header{
      position:sticky;top:0;z-index:50;
      background: rgba(7,20,38,.72);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    .header__inner{
      display:flex;align-items:center;justify-content:space-between;
      gap:14px; padding:12px 0;
    }
    .brand{display:flex;align-items:center;gap:12px;min-width:220px}
    .brand__logo{
      width:44px;height:44px;object-fit:contain;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,.35));
    }
    .brand__name{font-weight:800;letter-spacing:.2px}
    .brand__tag{font-size:12px;color:var(--muted)}

    .nav{display:flex;align-items:center;gap:18px}
    .nav a{color:var(--muted);font-weight:700}
    .nav a:hover{color:var(--text)}

    .nav__toggle{
      display:none;
      width:44px;height:44px;border-radius:12px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      cursor:pointer;
    }
    .nav__toggle span{display:block;height:2px;background:var(--text);margin:7px 10px;border-radius:2px}

    .btn{
      display:inline-flex;align-items:center;justify-content:center;
      gap:10px;
      padding:12px 16px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.18);
      background: linear-gradient(180deg, rgba(159,184,255,.18), rgba(255,255,255,.04));
      box-shadow: 0 12px 26px rgba(0,0,0,.26);
      font-weight:900;
      transition: transform .15s ease, filter .15s ease;
      white-space:nowrap;
    }
    .btn:hover{transform: translateY(-1px); filter: brightness(1.03)}
    .btn--ghost{
      background: rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.14);
      box-shadow:none;
    }
    .btn--sm{padding:9px 12px;border-radius:12px;font-size:14px}

    .hero{padding:54px 0 28px}
    .hero__grid{
      display:grid;
      grid-template-columns: 1.25fr .85fr;
      gap:22px;
      align-items:stretch;
    }
    .kicker{
      display:inline-flex;
      padding:6px 10px;border-radius:999px;
      border:1px solid var(--line);
      color:var(--muted);
      background: rgba(255,255,255,.03);
      font-weight:800;font-size:12px;
    }
    h1{font-size:44px;line-height:1.08;margin:14px 0 12px}
    .accent{color:var(--accent)}
    .lead{color:var(--muted);font-size:16px;max-width:62ch}
    .hero__cta{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0 18px}
    .hero__meta{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:10px;
      margin-top:10px;
    }
    .meta__item{
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: 16px;
      padding:14px;
    }
    .meta__num{font-weight:950;font-size:18px}
    .meta__label{color:var(--muted);font-size:12px;margin-top:4px}

    .section{padding:44px 0}
    .section--alt{
      background: linear-gradient(180deg, rgba(255,255,255,.03), transparent 60%);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .section__head{margin-bottom:18px}
    .section__head h2{margin:0 0 6px;font-size:26px}
    .section__head p{margin:0;color:var(--muted)}

    .card{
      border:1px solid var(--line);
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border-radius: var(--radius2);
      padding:20px;
      box-shadow: var(--shadow);
    }
    .card__title{font-weight:950;margin-bottom:10px}
    .card__actions{margin-top:14px}
    .link{color:var(--accent);font-weight:900}

    .checklist{margin:0;padding-left:18px;color:var(--muted)}
    .checklist li{margin:10px 0}

    .grid-4{
      display:grid;
      grid-template-columns: repeat(4,1fr);
      gap:12px;
    }
    .tile{
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: var(--radius);
      padding:16px;
    }
    .tile h3{margin:0 0 8px;font-size:16px}
    .tile p{margin:0;color:var(--muted);font-size:14px}

    .split{
      display:grid;
      grid-template-columns: 1.1fr .9fr;
      gap:16px;
      align-items:start;
    }
    .panel{
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: var(--radius2);
      padding:20px;
    }
    .panel__row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
    .pill{
      padding:8px 10px;border-radius:999px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.12);
      font-weight:900;font-size:12px;color:var(--muted);
    }
    .panel__big{margin:8px 0 14px}
    .panel__bigNum{font-size:44px;font-weight:950;line-height:1}
    .panel__bigText{color:var(--muted);margin-top:6px}

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .person{
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: var(--radius);
      padding:16px;
    }
    .person__title{color:var(--muted);font-weight:900;font-size:12px}
    .person__name{font-weight:950;font-size:18px;margin-top:6px}

    .motto{
      margin-top:14px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: var(--radius2);
      padding:16px;
    }
    .motto__label{color:var(--muted);font-weight:900;font-size:12px}
    .motto__text{font-weight:950;font-size:18px;margin-top:6px}

    .pagehead{
      padding:34px 0 10px;
      border-bottom: 1px solid var(--line);
    }
    .pagehead h1{margin:0 0 6px;font-size:34px}
    .pagehead p{margin:0;color:var(--muted)}

    .contact-card h2{margin:0 0 12px}
    .contact-list{display:grid;gap:12px;margin-top:8px}
    .contact-item{
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: 16px;
      padding:12px;
    }
    .contact-label{color:var(--muted);font-weight:900;font-size:12px}
    .contact-value{font-weight:900;margin-top:6px}
    .contact-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}

    .map{
      border:1px solid var(--line);
      border-radius: var(--radius2);
      overflow:hidden;
      background: rgba(255,255,255,.02);
      box-shadow: var(--shadow);
    }
    .map iframe{width:100%;height:520px;display:block}

    .footer{
      margin-top:30px;
      border-top: 1px solid var(--line);
      background: rgba(0,0,0,.18);
    }
    .footer__inner{
      padding:18px 0;
      display:flex;align-items:flex-start;justify-content:space-between;
      gap:14px;flex-wrap:wrap;
    }
    .footer__brand{font-weight:950}
    .footer__muted{color:var(--muted);font-size:12px;margin-top:6px}
    .footer__links{display:flex;gap:14px;flex-wrap:wrap}
    .footer__links a{color:var(--muted);font-weight:800}
    .footer__links a:hover{color:var(--text)}
    .footer__bottom{padding:12px 0;color:var(--muted);font-size:12px;border-top:1px solid var(--line)}

    .hidden{display:none}

    @media (max-width: 980px){
      .hero__grid{grid-template-columns:1fr}
      .grid-4{grid-template-columns:1fr 1fr}
      .split{grid-template-columns:1fr}
      h1{font-size:38px}
    }
    @media (max-width: 720px){
      .nav{display:none;flex-direction:column;align-items:flex-start;gap:10px}
      .nav.is-open{display:flex}
      .nav__toggle{display:inline-block}
      .grid-4{grid-template-columns:1fr}
      .hero__meta{grid-template-columns:1fr}
      .map iframe{height:420px}
    }
  </style>
</head>

<body>
  <header class="header">
    <div class="container header__inner">
      <a class="brand" href="#home" aria-label="На початок">
        <img class="brand__logo" src="logo.png" alt="Логотип Алмаз" />
        <div class="brand__text">
          <div class="brand__name">ХПВТП «Алмаз»</div>
          <div class="brand__tag">Будівництво • Девелопмент • Оренда</div>
        </div>
      </a>

      <button class="nav__toggle" type="button" aria-label="Відкрити меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" aria-label="Навігація">
        <a href="#home" data-page="home">Головна</a>
        <a href="#about" data-page="about">Про компанію</a>
        <a href="#objects" data-page="objects">Наші об’єкти</a>
        <a href="#rent" data-page="rent">Оренда складів</a>
        <a class="btn btn--sm" href="#contacts" data-page="contacts">Контакти</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- HOME -->
    <section id="home" data-section class="page">
      <section class="hero">
        <div class="container hero__grid">
          <div class="hero__content">
            <p class="kicker">Будівельна компанія • Хмельницький</p>
            <h1>Будуємо житло та інфраструктуру. <span class="accent">Надійно.</span></h1>
            <p class="lead">
              ХПВТП «Алмаз» — будівельна компанія, що займається зведенням багатоквартирних та приватних будинків,
              девелопментом земельних ділянок, створенням інженерних мереж і орендою складських приміщень.
            </p>

            <div class="hero__cta">
              <a class="btn" href="#objects" data-page="objects">Перейти до об’єктів</a>
              <a class="btn btn--ghost" href="#contacts" data-page="contacts">Зв’язатися</a>
            </div>

            <div class="hero__meta">
              <div class="meta__item">
                <div class="meta__num">30+</div>
                <div class="meta__label">років досвіду</div>
              </div>
              <div class="meta__item">
                <div class="meta__num">Житло</div>
                <div class="meta__label">багатоквартирне та приватне</div>
              </div>
              <div class="meta__item">
                <div class="meta__num">Склади</div>
                <div class="meta__label">оренда різних площ</div>
              </div>
            </div>
          </div>

          <div class="hero__card">
            <div class="card">
              <div class="card__title">Коротко про компанію</div>
              <ul class="checklist">
                <li>Будівництво багатоквартирних і приватних будинків</li>
                <li>Забудова та розвиток земельних ділянок</li>
                <li>Інженерні мережі: газ, вода, електрика, каналізація</li>
                <li>Оренда складських приміщень</li>
              </ul>
              <div class="card__actions">
                <a class="link" href="#about" data-page="about">Детальніше про компанію →</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section__head">
            <h2>Напрями діяльності</h2>
            <p>Ключові напрямки роботи компанії.</p>
          </div>

          <div class="grid-4">
            <article class="tile">
              <h3>Будівництво житла</h3>
              <p>Багатоквартирні та приватні будинки, комплексна забудова територій.</p>
            </article>

            <article class="tile">
              <h3>Девелопмент</h3>
              <p>Розвиток земельних ділянок, реалізація проектів забудови міських територій.</p>
            </article>

            <article class="tile">
              <h3>Інженерні мережі</h3>
              <p>Газ, водопостачання, електропостачання, каналізаційні мережі.</p>
            </article>

            <article class="tile">
              <h3>Оренда складів</h3>
              <p>Складські приміщення різних площ для бізнесу та виробництва.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="container">
          <div class="split">
            <div>
              <h2>Кооператив «Алмазний»</h2>
              <p>
                Компанією «Алмаз» створено обслуговуючий кооператив «Алмазний» та побудовано власну інфраструктуру:
                газ, водопровід, електропостачання та каналізаційна мережа.
              </p>
              <p>
                Кооператив на сьогодні налічує <strong>понад 60 земельних ділянок</strong>, які вже мають власників та активно розбудовуються.
              </p>
            </div>

            <div class="panel">
              <div class="panel__row">
                <div class="pill">Газ</div>
                <div class="pill">Вода</div>
                <div class="pill">Електрика</div>
                <div class="pill">Каналізація</div>
              </div>
              <div class="panel__big">
                <div class="panel__bigNum">60+</div>
                <div class="panel__bigText">земельних ділянок</div>
              </div>
              <a class="btn btn--ghost" href="#contacts" data-page="contacts">Зв’язатися</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section__head">
            <h2>Керівництво</h2>
            <p>Відповідальність за результат та якість виконання робіт.</p>
          </div>

          <div class="grid-2">
            <div class="person">
              <div class="person__title">Генеральний директор</div>
              <div class="person__name">Гуменюк Василь Михайлович</div>
            </div>

            <div class="person">
              <div class="person__title">Виконавчий директор</div>
              <div class="person__name">Репетюк Євгенія Євгеніївна</div>
            </div>
          </div>

          <div class="motto">
            <div class="motto__label">Девіз підприємства</div>
            <div class="motto__text">«Підприємці і влада — партнери»</div>
          </div>
        </div>
      </section>
    </section>

    <!-- ABOUT -->
    <section id="about" data-section class="page hidden">
      <section class="pagehead">
        <div class="container">
          <h1>Про компанію</h1>
          <p>ХПВТП «Алмаз» — досвід, відповідальність та системний підхід у будівництві.</p>
        </div>
      </section>

      <section class="section">
        <div class="container split">
          <div class="card">
            <div class="card__title">ХПВТП «Алмаз»</div>
            <p style="margin:0;color:var(--muted)">
              Компанія займається будівництвом багатоквартирних та приватних будинків, девелопментом земельних ділянок,
              створенням інженерних мереж, а також здає в оренду складські приміщення різних площ.
            </p>
            <p style="margin:14px 0 0;color:var(--muted)">
              Компанія має в активах земельні ділянки та бере участь у забудові міських територій у співпраці з партнерами.
            </p>
          </div>

          <div class="panel">
            <div class="card__title">Сильні сторони</div>
            <ul class="checklist">
              <li>Повний цикл робіт: від ділянки до готового об’єкта</li>
              <li>Досвід реалізації житлових та інфраструктурних проектів</li>
              <li>Власні земельні активи</li>
              <li>Створення інженерної інфраструктури</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="container">
          <div class="section__head">
            <h2>Досвід і розвиток</h2>
            <p>Багатопрофільний шлях, що сформував сильну матеріально-технічну базу.</p>
          </div>
          <div class="grid-4">
            <article class="tile">
              <h3>Будівництво</h3>
              <p>Житлові об’єкти — багатоквартирні та приватні будинки.</p>
            </article>
            <article class="tile">
              <h3>Матеріали</h3>
              <p>Раніше — продаж будівельних матеріалів і металопрокату.</p>
            </article>
            <article class="tile">
              <h3>Агросектор</h3>
              <p>Досвід у суміжних напрямках: садівництво та тваринництво.</p>
            </article>
            <article class="tile">
              <h3>Інфраструктура</h3>
              <p>Газ, вода, електрика, каналізаційні мережі — підведення та розвиток.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section__head">
            <h2>Керівництво</h2>
            <p>Ключові особи компанії.</p>
          </div>
          <div class="grid-2">
            <div class="person">
              <div class="person__title">Генеральний директор</div>
              <div class="person__name">Гуменюк Василь Михайлович</div>
            </div>
            <div class="person">
              <div class="person__title">Виконавчий директор</div>
              <div class="person__name">Репетюк Євгенія Євгеніївна</div>
            </div>
          </div>
        </div>
      </section>
    </section>

    <!-- OBJECTS -->
    <section id="objects" data-section class="page hidden">
      <section class="pagehead">
        <div class="container">
          <h1>Наші об’єкти</h1>
          <p>Сторінка для переліку об’єктів і проектів (структура під додавання інформації).</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="grid-4">
            <article class="tile">
              <h3>Багатоквартирні будинки</h3>
              <p>Перелік житлових будинків із можливістю додати адресу та короткий опис.</p>
            </article>
            <article class="tile">
              <h3>Приватні будинки</h3>
              <p>Проекти приватної забудови з можливістю додати локацію та параметри.</p>
            </article>
            <article class="tile">
              <h3>Комерційні об’єкти</h3>
              <p>Адміністративні, виробничі та інші об’єкти.</p>
            </article>
            <article class="tile">
              <h3>Інженерні мережі</h3>
              <p>Інфраструктурні роботи та мережі: газ, вода, електрика, каналізація.</p>
            </article>
          </div>

          <div style="margin-top:14px" class="card">
            <div class="card__title">Додавання об’єктів</div>
            <ul class="checklist">
              <li>Назва / адреса</li>
              <li>Тип (багатоквартирний / приватний / комерційний)</li>
              <li>Короткий опис</li>
              <li>Статус (збудовано / в процесі / заплановано)</li>
            </ul>
          </div>
        </div>
      </section>
    </section>

    <!-- RENT -->
