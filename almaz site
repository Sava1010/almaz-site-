<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ХПВТП «Алмаз» — будівельна компанія, Хмельницький</title>
  <meta name="description" content="ХПВТП «Алмаз» — будівельна компанія з Хмельницького. Будівництво багатоквартирних і приватних будинків, девелопмент, інженерні мережі, оренда складів." />
  <meta name="theme-color" content="#0A1E3A" />

  <meta property="og:title" content="ХПВТП «Алмаз»" />
  <meta property="og:description" content="Будівництво житла та інфраструктури в Хмельницькому. Працюємо багато років — будуємо відповідально." />
  <meta property="og:type" content="website" />

  <link rel="icon" href="img/favicon.png" />
  <link rel="stylesheet" href="css/style.css" />
</head>

<body>
  <header class="header">
    <div class="container header__inner">
      <a class="brand" href="index.html" aria-label="На головну">
        <img class="brand__logo" src="img/logo.png" alt="Логотип Алмаз" />
        <div class="brand__text">
          <div class="brand__name">ХПВТП «Алмаз»</div>
          <div class="brand__tag">Будівництво • Девелопмент • Оренда</div>
        </div>
      </a>

      <button class="nav__toggle" type="button" aria-label="Відкрити меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" aria-label="Навігація">
        <a href="about.html">Про компанію</a>
        <a href="objects.html">Наші об’єкти</a>
        <a href="rent.html">Оренда складів</a>
        <a class="btn btn--sm" href="contacts.html">Контакти</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__content">
          <p class="kicker">Будівельна компанія • Хмельницький</p>
          <h1>Будуємо житло та інфраструктуру. <span class="accent">Надійно.</span></h1>
          <p class="lead">
            ХПВТП «Алмаз» — компанія з Хмельницького, що працює у сфері будівництва багатоквартирних та приватних будинків,
            розвитку земельних ділянок, створення інженерних мереж та оренди складських приміщень.
          </p>

          <div class="hero__cta">
            <a class="btn" href="objects.html">Подивитися об’єкти</a>
            <a class="btn btn--ghost" href="contacts.html">Зв’язатися</a>
          </div>

          <div class="hero__meta">
            <div class="meta__item">
              <div class="meta__num">30+</div>
              <div class="meta__label">років досвіду</div>
            </div>
            <div class="meta__item">
              <div class="meta__num">Житло</div>
              <div class="meta__label">багатоквартирне та приватне</div>
            </div>
            <div class="meta__item">
              <div class="meta__num">Склади</div>
              <div class="meta__label">оренда різних площ</div>
            </div>
          </div>
        </div>

        <div class="hero__card">
          <div class="card">
            <div class="card__title">Коротко про нас</div>
            <ul class="checklist">
              <li>Будівництво житлових і комерційних об’єктів</li>
              <li>Девелопмент земельних ділянок</li>
              <li>Інженерні мережі: газ, вода, електрика, каналізація</li>
              <li>Оренда складських приміщень</li>
            </ul>
            <div class="card__actions">
              <a class="link" href="about.html">Детальніше про компанію →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DIRECTIONS -->
    <section class="section">
      <div class="container">
        <div class="section__head">
          <h2>Напрями діяльності</h2>
          <p>Чітко, по суті — те, що компанія робить на практиці.</p>
        </div>

        <div class="grid-4">
          <article class="tile">
            <h3>Будівництво житла</h3>
            <p>Багатоквартирні та приватні будинки, комплексна забудова територій.</p>
          </article>

          <article class="tile">
            <h3>Девелопмент</h3>
            <p>Розвиток земельних ділянок, підготовка територій, реалізація проектів забудови.</p>
          </article>

          <article class="tile">
            <h3>Інженерні мережі</h3>
            <p>Комунікації “під ключ”: газ, водопровід, електропостачання, каналізаційні мережі.</p>
          </article>

          <article class="tile">
            <h3>Оренда складів</h3>
            <p>Складські приміщення різних площ для бізнесу, виробництва та логістики.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- COOP -->
    <section class="section section--alt">
      <div class="container">
        <div class="split">
          <div>
            <h2>Кооператив «Алмазний»</h2>
            <p>
              Компанією «Алмаз» створено обслуговуючий кооператив «Алмазний» та збудовано власну інфраструктуру:
              газ, водопровід, електропостачання та каналізаційна мережа.
            </p>
            <p>
              Кооператив налічує <strong>понад 60 земельних ділянок</strong>, які вже мають власників та активно розбудовуються.
            </p>
            <div class="note">
              Окремий сайт кооперативу зробимо на WordPress (каталог ділянок, новини, документи).
            </div>
          </div>

          <div class="panel">
            <div class="panel__row">
              <div class="pill">Газ</div>
              <div class="pill">Вода</div>
              <div class="pill">Електрика</div>
              <div class="pill">Каналізація</div>
            </div>
            <div class="panel__big">
              <div class="panel__bigNum">60+</div>
              <div class="panel__bigText">земельних ділянок</div>
            </div>
            <a class="btn btn--ghost" href="contacts.html">Отримати консультацію</a>
          </div>
        </div>
      </div>
    </section>

    <!-- MANAGEMENT -->
    <section class="section">
      <div class="container">
        <div class="section__head">
          <h2>Керівництво</h2>
          <p>Контроль якості та відповідальність за результат — на керівниках.</p>
        </div>

        <div class="grid-2">
          <div class="person">
            <div class="person__title">Генеральний директор</div>
            <div class="person__name">Гуменюк Василь Михайлович</div>
          </div>

          <div class="person">
            <div class="person__title">Виконавчий директор</div>
            <div class="person__name">Репетюк Євгенія Євгеніївна</div>
          </div>
        </div>

        <div class="motto">
          <div class="motto__label">Девіз підприємства</div>
          <div class="motto__text">«Підприємці і влада — партнери»</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="container cta__inner">
        <div>
          <h2>Потрібна консультація або співпраця?</h2>
          <p>Зв’яжіться з нами — відповімо швидко та по суті.</p>
        </div>
        <div class="cta__actions">
          <a class="btn" href="contacts.html">Контакти</a>
          <a class="btn btn--ghost" href="rent.html">Оренда складів</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <div>
        <div class="footer__brand">ХПВТП «Алмаз»</div>
        <div class="footer__muted">Будівництво • Девелопмент • Оренда</div>
      </div>
      <div class="footer__links">
        <a href="about.html">Про компанію</a>
        <a href="objects.html">Об’єкти</a>
        <a href="rent.html">Оренда</a>
        <a href="contacts.html">Контакти</a>
      </div>
    </div>
    <div class="container footer__bottom">
      <span>© <span id="year"></span> ХПВТП «Алмаз». Усі права захищено.</span>
    </div>
  </footer>

  <script src="js/script.js"></script>
</body>
</html>

